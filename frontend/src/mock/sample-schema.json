{
  "type": "object",
  "title": "用户信息",
  "fields": [
    {
      "name": "section1",
      "type": "void",
      "title": "基本信息",
      "component": "Divider",
      "hidden-value": true,
      "componentProps": {
        "content": "基本信息"
      }
    },
    {
      "name": "name",
      "type": "string",
      "title": "姓名",
      "required": true,
      "component": "Input",
      "componentProps": {
        "placeholder": "请输入姓名",
        "maxlength": 50,
        "clearable": true
      },
      "rules": [
        {
          "required": true,
          "message": "请输入姓名"
        }
      ]
    },
    {
      "name": "gender",
      "type": "string",
      "title": "性别",
      "required": true,
      "enum": ["male", "female"],
      "component": "Radio",
      "componentProps": {
        "options": [
          { "label": "男", "value": "male" },
          { "label": "女", "value": "female" }
        ]
      },
      "rules": [
        {
          "required": true,
          "message": "请选择性别"
        }
      ]
    },
    {
      "name": "age",
      "type": "number",
      "title": "年龄",
      "component": "InputNumber",
      "componentProps": {
        "min": 1,
        "max": 120,
        "step": 1
      }
    },
    {
      "name": "hobbies",
      "type": "array",
      "title": "爱好",
      "default": [],
      "component": "Checkbox",
      "componentProps": {
        "options": [
          { "label": "阅读", "value": "reading" },
          { "label": "运动", "value": "sport" },
          { "label": "音乐", "value": "music" }
        ]
      }
    },
    {
      "name": "bio",
      "type": "string",
      "title": "简介",
      "component": "Textarea",
      "componentProps": {
        "placeholder": "简单介绍一下自己",
        "maxlength": 200
      }
    },
    {
      "name": "agree",
      "type": "boolean",
      "title": "同意协议",
      "default": false,
      "component": "Switch",
      "componentProps": {
        "activeText": "是",
        "inactiveText": "否"
      }
    },
    {
      "name": "birthday",
      "type": "string",
      "title": "生日",
      "component": "DatePicker",
      "componentProps": {
        "placeholder": "请选择日期",
        "format": "YYYY-MM-DD",
        "valueFormat": "YYYY-MM-DD",
        "clearable": true
      }
    }
  ]
}
